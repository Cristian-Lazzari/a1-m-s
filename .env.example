APP_NAME="Future Plus WhatsApp"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://whatsapp.future-plus.it

LOG_CHANNEL=daily
LOG_LEVEL=info

# Database dell'hub: utente MySQL dedicato, con permessi SOLO su questo database.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# Casella per gli avvisi di errore
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
WA_ALERT_RECIPIENT=info@future-plus.it

# App Meta di Future Plus (Impostazioni → Di base)
META_APP_ID=
META_APP_SECRET=
# Facebook Login for Business → Configurazioni → WhatsApp Embedded Signup
META_ES_CONFIG_ID=
META_GRAPH_VERSION=v24.0

# Stringa casuale, la stessa da scrivere in WhatsApp → Configurazione → Verifica token
WA_WEBHOOK_VERIFY_TOKEN=

# Numero di piattaforma (quello che avvisa i ristoratori): ID del numero e
# token permanente di un utente di sistema del portfolio Future Plus.
WA_PLATFORM_PHONE_NUMBER_ID=
WA_PLATFORM_TOKEN=
